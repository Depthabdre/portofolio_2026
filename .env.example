# Supabase configuration (from the project's Connect dialog / Settings -> API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required for admin publishing. Server only: never expose this key to the browser.
SUPABASE_SECRET_KEY=your-secret-key

# Single-owner admin password. No fallback password is provided.
ADMIN_PASSWORD=change-this-to-a-secure-password
